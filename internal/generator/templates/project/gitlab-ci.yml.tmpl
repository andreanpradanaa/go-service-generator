stages:
  - analysis
  - package
  - deploy
  - notify

variables:
  # CI VARIABLES
  IMAGE_PATH: $HARBOR_REGISTRY/$CI_PROJECT_PATH
  MANIFEST: {{.Manifest}}

Sonar Check:
 stage: analysis
 image:
   name: sonarsource/sonar-scanner-cli:latest
   entrypoint: [ "" ]
 variables:
   SONAR_USER_HOME: "${CI_PROJECT_DIR}/.sonar"  # Defines the location of the analysis task cache
   GIT_DEPTH: "0"  # Tells git to fetch all the branches of the project, required by the analysis task
 script:
   - sonar-scanner -Dsonar.qualitygate.wait=true -Dsonar.host.url=$SONAR_URL -Dsonar.token=$SONAR_TOKEN
 cache:
   key: "${CI_JOB_NAME}"
   paths:
     - .sonar/cache
 only:
   - development
 tags:
   - security
 needs: []
 allow_failure: false

Package Container:
  stage: package
  image: docker:20.10.5
  before_script:
    - docker login -u $HARBOR_USER -p $HARBOR_PASSWORD $HARBOR_REGISTRY
    - export IMAGE_TAG_SHA="${IMAGE_PATH}:${CI_COMMIT_SHORT_SHA}"
    - export IMAGE_TAG="${IMAGE_PATH}:${CI_COMMIT_REF_NAME}"
  script:
    - docker build --no-cache -t $IMAGE_TAG_SHA --build-arg APP_COMMIT_ID="$CI_COMMIT_SHORT_SHA" --build-arg CI_JOB_TOKEN="$CI_JOB_TOKEN" -f docker/Dockerfile .
    - |
      if [[ -n "$CI_COMMIT_TAG" ]]; then
        docker tag $IMAGE_TAG_SHA $IMAGE_TAG
        docker push $IMAGE_TAG
      else
        docker push $IMAGE_TAG_SHA
      fi
  only:
    - development
    - tags
  tags:
    - docker-runner-dg
  needs: []

Deploy to Development:
  stage: deploy
  image: alpine:3.19
  before_script:
    - apk add --no-cache git curl wget
    - wget https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64.tar.gz -O - | tar xz && mv yq_linux_amd64 /usr/bin/yq
    - git config --global user.name "$GITOPS_USER"
    - git config --global user.email "$GITOPS_EMAIL"
    - git clone https://${GITOPS_USER}:${GITOPS_TOKEN}@kukang.networkintegrator.id/devops/k8s-manifest-ni.git
  script:
    - cd k8s-manifest-ni/$MANIFEST
    - yq e ".image.tag = \"$CI_COMMIT_SHORT_SHA\"" -i values-development.yaml
    - |
      if [ -n "$(git status --porcelain)" ]; then
        git add values-development.yaml
        git commit -m "🔧 image $CI_COMMIT_SHORT_SHA for $CI_PROJECT_NAME"

        MAX_RETRIES=5
        RETRY_COUNT=0
        SUCCESS=false

        while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
          # Always pull the latest changes before trying to push
          git pull --rebase origin main

          if git push origin main; then
            SUCCESS=true
            echo "Successfully pushed to GitOps repository."
            break
          else
            echo "Push failed due to conflict/lock. Retrying ($RETRY_COUNT/$MAX_RETRIES)..."
            RETRY_COUNT=$((RETRY_COUNT+1))
            # Sleep random 1-5 seconds
            sleep $((RANDOM % 5 + 1))
          fi
        done

        if [ "$SUCCESS" = false ]; then
          echo "Error: Failed to push to GitOps repo after $MAX_RETRIES attempts."
          exit 1
        fi
      else
        echo "No changes detected, skipping deploy."
      fi
  only:
    - development
  tags:
    - docker-runner-dg
  needs: ["Package Container"]

Deploy to Production:
  stage: deploy
  image: alpine:3.19
  before_script:
    - apk add --no-cache git curl wget
    - wget https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64.tar.gz -O - | tar xz && mv yq_linux_amd64 /usr/bin/yq
    - git config --global user.name "$GITOPS_USER"
    - git config --global user.email "$GITOPS_EMAIL"
    - git clone https://${GITOPS_USER}:${GITOPS_TOKEN}@kukang.networkintegrator.id/devops/k8s-manifest-ni.git
  script:
    - cd k8s-manifest-ni/$MANIFEST
    - yq e ".image.tag = \"$CI_COMMIT_TAG\"" -i values-qw-gandul.yaml
    - |
      if [ -n "$(git status --porcelain)" ]; then
        git add values-qw-gandul.yaml
        git commit -m "🔧 image $CI_COMMIT_TAG for $CI_PROJECT_NAME"

        MAX_RETRIES=5
        RETRY_COUNT=0
        SUCCESS=false

        while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
          # Always pull the latest changes before trying to push
          git pull --rebase origin main

          if git push origin main; then
            SUCCESS=true
            echo "Successfully pushed to GitOps repository."
            break
          else
            echo "Push failed due to conflict/lock. Retrying ($RETRY_COUNT/$MAX_RETRIES)..."
            RETRY_COUNT=$((RETRY_COUNT+1))
            # Sleep random 1-5 seconds
            sleep $((RANDOM % 5 + 1))
          fi
        done

        if [ "$SUCCESS" = false ]; then
          echo "Error: Failed to push to GitOps repo after $MAX_RETRIES attempts."
          exit 1
        fi
      else
        echo "No changes detected, skipping deploy."
      fi
  only:
    - tags
  tags:
    - docker-runner-dg
  needs: ["Package Container"]

notify_success:
  stage: notify
  image: alpine:3.19
  before_script:
    - apk add bash curl jq git
  tags:
    - docker-runner-dg
  needs:
    - job: Deploy to Development
      optional: true
    - job: Deploy to Production
      optional: true
  script:
    - |
      # Add all environment variables GitLab CI
      json_payload=$(jq -n --arg pipeline_status "$PIPELINE_STATUS" '
        env
        | del(
            .N8N_API_KEY,
            .CI_JOB_TOKEN,
            .CI_REGISTRY_PASSWORD,
            .CI_DEPLOY_PASSWORD
          )
        | . + {
            PIPELINE_STATUS: $pipeline_status
          }
      ')

      curl --fail-with-body -sS -X POST https://n8n.onemove.id/webhook/repo-iconx/deployment/notification \
      -H "Content-Type: application/json" \
      -H "X-API-KEY: DeploymentNotification" \
      -H "STATUS: SUCCESS" \
      --data-binary "$json_payload"
  rules:
    - if: $CI_PIPELINE_SOURCE != "merge_request_event"
      when: on_success

notify_failure:
  stage: .post
  image: alpine:3.19
  before_script:
    - apk add bash curl jq git
  tags:
    - docker-runner-dg
  script:
    - |
      # Add all environment variables GitLab CI
      json_payload=$(jq -n --arg pipeline_status "$PIPELINE_STATUS" '
        env
        | del(
            .N8N_API_KEY,
            .CI_JOB_TOKEN,
            .CI_REGISTRY_PASSWORD,
            .CI_DEPLOY_PASSWORD
          )
        | . + {
            PIPELINE_STATUS: $pipeline_status
          }
      ')

      curl --fail-with-body -sS -X POST https://n8n.onemove.id/webhook/repo-iconx/deployment/notification \
      -H "Content-Type: application/json" \
      -H "X-API-KEY: DeploymentNotification" \
      -H "STATUS: ERROR" \
      --data-binary "$json_payload"
  when: on_failure
