// Package rc maps responses from partners and the gateway to this service's
// own outward response code and message, per the SNAP response code table.
package rc

import (
	"strconv"
	"strings"
)

// Response is this service's own outward response envelope. ResponseCode is
// the full 7-digit code: HTTPStatusCode(3) + service code(2) + case code(2).
type Response struct {
	ResponseMessage string
	HTTPStatusCode  int
	ResponseCode    string
}

// Service codes identify which of this service's own endpoints produced a
// response. They occupy digits 4-5 of ResponseCode.
const (
)

// serviceCodeByPath maps every route this service exposes to its service code.
var serviceCodeByPath = map[string]string{
}

// ServiceCodeFor returns the service code for a request path. Every route
// this service exposes is in serviceCodeByPath; "00" is a defensive fallback
// for a path that isn't (there shouldn't be one).
func ServiceCodeFor(path string) string {
	if code, ok := serviceCodeByPath[path]; ok {
		return code
	}
	return "00"
}

// rcKey identifies one row of the SNAP response code table: HTTP status + case code. Service code is
// always "any" in the table, so it's not part of the key.
type rcKey struct {
	httpCode int
	caseCode string
}

// messages is the SNAP response code table: every (HTTP code, case code) pair this
// service can return, and the message for it.
var messages = map[rcKey]string{
	{200, "00"}: "Successful",
	{202, "00"}: "Request In Progress",

	{400, "00"}: "Bad Request",
	{400, "01"}: "Invalid Field Format {field name}",
	{400, "02"}: "Invalid Mandatory Field {field name}",

	{401, "00"}: "Unauthorized. [reason]",
	{401, "01"}: "Invalid Token (B2B)",
	{401, "02"}: "Invalid Customer Token",
	{401, "03"}: "Token Not Found (B2B)",
	{401, "04"}: "Customer Token Not Found",

	{403, "00"}: "Transaction Expired",
	{403, "01"}: "Feature Not Allowed [Reason]",
	{403, "02"}: "Exceeds Transaction Amount Limit",
	{403, "03"}: "Suspected Fraud",
	{403, "04"}: "Activity Count Limit Exceeded",
