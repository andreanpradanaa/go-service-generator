// at looks up a table row by HTTP code and case code, and assembles the full
// 7-digit ResponseCode for the given service.
func at(httpCode int, serviceCode, caseCode string) Response {
	return Response{
		ResponseMessage: messages[rcKey{httpCode, caseCode}],
		HTTPStatusCode:  httpCode,
		ResponseCode:    strconv.Itoa(httpCode) + serviceCode + caseCode,
	}
}

// atf is at, with a placeholder (e.g. "{field name}", "[reason]") filled in.
func atf(httpCode int, serviceCode, caseCode, placeholder, value string) Response {
	r := at(httpCode, serviceCode, caseCode)
	r.ResponseMessage = strings.Replace(r.ResponseMessage, placeholder, value, 1)
	return r
}

// Responses for errors this service detects itself, before ever calling a
// partner or the gateway. serviceCode identifies which endpoint is responding — use
// ServiceCodeFor(c.Path()) or one of the Service* constants.
func Successful(serviceCode string) Response          { return at(200, serviceCode, "00") }
func BadRequest(serviceCode string) Response          { return at(400, serviceCode, "00") }
func InternalServerError(serviceCode string) Response { return at(500, serviceCode, "01") }
func Timeout(serviceCode string) Response             { return at(504, serviceCode, "00") }

func ClientNotFound(serviceCode string) Response {
	return atf(401, serviceCode, "00", "[reason]", "Unknown Client")
}

func MissingHeaderTimestamp(serviceCode string) Response {
	return atf(400, serviceCode, "02", "{field name}", "timestamp")
}

func MissingHeaderPspId(serviceCode string) Response {
	return atf(400, serviceCode, "02", "{field name}", "psp-id")
}

func MissingHeaderSignature(serviceCode string) Response {
	return atf(400, serviceCode, "02", "{field name}", "signature")
}

func InvalidHeaderTimestamp(serviceCode string) Response {
	return atf(400, serviceCode, "01", "{field name}", "timestamp")
}

func InvalidHeaderSignature(serviceCode string) Response {
	return atf(400, serviceCode, "01", "{field name}", "signature")
}

func InvalidFieldFormat(serviceCode, fieldName string) Response {
	return atf(400, serviceCode, "01", "{field name}", fieldName)
}

// FromHTTPStatus maps an HTTP error raised outside this service's handlers
// (e.g. fiber's 404 for an unknown route) to a Response with the same status.
// Statuses without a matching table row keep the given message.
func FromHTTPStatus(serviceCode string, httpCode int, message string) Response {
	switch httpCode {
	case 404:
		return at(404, serviceCode, "02") // Invalid Routing
	case 500:
		return InternalServerError(serviceCode)
	}
	if _, ok := messages[rcKey{httpCode, "00"}]; ok {
		return at(httpCode, serviceCode, "00")
	}
	return Response{
		ResponseMessage: message,
		HTTPStatusCode:  httpCode,
		ResponseCode:    strconv.Itoa(httpCode) + serviceCode + "00",
	}
}

// FromCode maps a wire response code (3-digit HTTP code + 2-digit service
// code + 2-digit case code — the SNAP shape partners and the gateway return)
// to this service's own Response. Unknown or malformed codes fall back to
// InternalServerError. serviceCode is this service's own endpoint, not the
// one parsed out of the wire code.
func FromCode(serviceCode, code string) Response {
	if len(code) != 7 {
		return InternalServerError(serviceCode)
	}

	httpCode, err := strconv.Atoi(code[:3])
	if err != nil {
		return InternalServerError(serviceCode)
	}

	caseCode := code[5:7]
	if _, ok := messages[rcKey{httpCode, caseCode}]; !ok {
		return InternalServerError(serviceCode)
	}

	return at(httpCode, serviceCode, caseCode)
}
